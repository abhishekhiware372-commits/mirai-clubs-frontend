# MIRAI CLUBS — Frontend Environment Configuration
# API Connection Settings

# FastAPI Backend Base URL (defaults to localhost:8000/api/v1 if not specified)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Operational Mode
# When 'true', allows instant offline demo access using isolated mock data repository
# When 'false', connects strictly to live FastAPI backend
NEXT_PUBLIC_USE_MOCK=false

# Institutional Configuration
NEXT_PUBLIC_CAMPUS_NAME="Mirai School of Technology"
NEXT_PUBLIC_SYSTEM_VERSION="1.0.0-MSOT-CHALLENGE"
